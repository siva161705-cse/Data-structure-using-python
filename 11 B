# Social Network using BFS and DFS

# Number of users
n = int(input("Enter number of users: "))

# Create adjacency list
graph = [[] for _ in range(n)]

# Number of friendships
e = int(input("Enter number of friendships: "))

# Enter friendships
print("\nEnter the friendships:")
for i in range(e):
    u = int(input("Enter first user: "))
    v = int(input("Enter second user: "))

    graph[u].append(v)
    graph[v].append(u)   # Friendship is bidirectional


# Display the social network
print("\nSocial Network:")
for i in range(n):
    print(i, "->", graph[i])


# Find friends of a given user
user = int(input("\nEnter user to find friends: "))

print("Friends of user", user, ":", graph[user])


# ---------------- BFS ----------------

def bfs(graph, start):
    visited = [False] * len(graph)
    queue = []

    visited[start] = True
    queue.append(start)

    result = []

    while queue:
        current = queue.pop(0)
        result.append(current)

        for friend in graph[current]:
            if not visited[friend]:
                visited[friend] = True
                queue.append(friend)

    return result


# ---------------- DFS ----------------

def dfs(graph, start, visited, result):
    visited[start] = True
    result.append(start)

    for friend in graph[start]:
        if not visited[friend]:
            dfs(graph, friend, visited, result)


# Starting user for traversal
start = int(input("\nEnter starting user for BFS and DFS: "))


# BFS traversal
bfs_result = bfs(graph, start)

print("\nBFS Traversal:")
print(*bfs_result)


# DFS traversal
visited = [False] * n
dfs_result = []

dfs(graph, start, visited, dfs_result)

print("\nDFS Traversal:")
print(*dfs_result)
